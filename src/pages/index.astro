---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleGrid from '../components/home/ModuleGrid.astro';
import { HeroDiagram } from '../components/home/HeroDiagram';
import { loadCatalog } from '../lib/load-catalog';
import { MODULES } from '../data/modules';
import { siteConfig } from '../config/site';

const catalog = await loadCatalog();
const courseIds = new Set(MODULES.map((m) => m.id));
const courseModules = catalog.filter((m) => courseIds.has(m.id));
const first = catalog.flatMap((m) => m.lessons).find((l) => l.href);
const total = courseModules.reduce((n, m) => n + m.lessons.length, 0);
---
<BaseLayout
  title="Logic Apps — an interactive course"
  description="Learn Azure Logic Apps one animated step at a time: runs, hosting, reliability, integration patterns and agentic workflows."
>
  <div class="home">
    <section class="hero">
      <div>
        <p class="hero__eyebrow">Free · {MODULES.length} modules · {total} lessons</p>
        <h1>See how Logic Apps really run.</h1>
        <p>
          Follow a run hop by hop: triggers, actions, retries, hosting plans and AI agents, animated one step at a time.
          Built for Azure integration developers who want to know what actually happens, not only which button to click.
        </p>
        <div class="hero__actions">
          {first
            ? <a class="btn btn--primary" href={first.href}>Start the course</a>
            : <a class="btn btn--primary" href="#modules">See what's coming</a>}
          <a class="btn" href="#module-agentic"><span class="badge-new">NEW</span> Agentic Logic Apps</a>
        </div>
      </div>
      <div class="panel hero__art">
        <HeroDiagram client:visible />
      </div>
    </section>

    <h2 class="section-title">The course</h2>
    <ModuleGrid modules={courseModules} />

    <div class="panel about">
      Written by Daniel Jonathan, Azure integration specialist.
      {siteConfig.devtoUrl && <> More of his Logic Apps writing is <a href={siteConfig.devtoUrl} data-track="devto_click">on dev.to</a>.</>}
    </div>
  </div>
</BaseLayout>
