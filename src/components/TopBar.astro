---
import { withBase } from '../lib/paths';
import { ThemeToggle } from './ThemeToggle';
import { siteConfig } from '../config/site';
---
<header class="topbar">
  <button type="button" class="icon-btn menu-btn" id="menu-btn" aria-label="Open course menu" aria-controls="sidebar" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
  </button>
  <a href={withBase('/')} class="brand">
    <svg class="brand__mark" viewBox="0 0 26 26" aria-hidden="true">
      <rect x="1" y="1" width="10" height="10" rx="3" fill="var(--accent)" />
      <rect x="15" y="15" width="10" height="10" rx="3" fill="none" stroke="var(--fg)" stroke-width="2" />
      <path d="M6 11 V20 H15" fill="none" stroke="var(--fg)" stroke-width="2" />
    </svg>
    <span>Logic Apps <small>a visual guide</small></span>
  </a>
  <div class="topbar__end">
    {siteConfig.devtoUrl
      ? <a class="credit" href={siteConfig.devtoUrl} data-track="devto_click">by Daniel Jonathan</a>
      : <span class="credit">by Daniel Jonathan</span>}
    <ThemeToggle client:load />
  </div>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const sidebar = document.getElementById('sidebar');
  btn?.addEventListener('click', () => {
    const open = sidebar?.getAttribute('data-open') !== 'true';
    sidebar?.setAttribute('data-open', String(open));
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close course menu' : 'Open course menu');
  });
</script>
